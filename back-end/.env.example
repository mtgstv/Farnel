# OPCIONAL. Sem este arquivo, a API usa o banco do Docker (docker-compose.yml), que é o recomendado.
# Use só se quiser trocar o banco do Docker pelo PostgreSQL instalado no seu computador:
# 1. Crie o banco "farnel" no seu PostgreSQL (pelo pgAdmin, por exemplo).
# 2. Copie este arquivo para ".env", na mesma pasta (back-end/.env).
# 3. Troque os valores pelos do SEU PostgreSQL.
# O .env não vai para o GitHub (está no .gitignore): cada integrante tem o seu.
# Observação: se a senha tiver uma barra invertida (\), escreva duas (\\).

DB_URL=jdbc:postgresql://localhost:5432/farnel
DB_USUARIO=postgres
DB_SENHA=coloque-aqui-a-senha-do-postgres
